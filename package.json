{
  "name": "packlight-cli",
  "version": "0.1.1",
  "description": "See what your coding agent carries, keep what you use, archive the rest.",
  "keywords": [
    "claude-code",
    "claude",
    "mcp",
    "skills",
    "hooks",
    "context",
    "tokens",
    "cli",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "Cooper Kao (https://github.com/cooperism-lab)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cooperism-lab/packlight.git"
  },
  "homepage": "https://github.com/cooperism-lab/packlight#readme",
  "bugs": {
    "url": "https://github.com/cooperism-lab/packlight/issues"
  },
  "type": "module",
  "bin": {
    "packlight": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scan": "node --import tsx src/cli.ts scan",
    "e2e": "npm run build && playwright test",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo": "npm run build && node --import tsx scripts/build-demo.mts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/write-file-atomic": "4.0.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "write-file-atomic": "6.0.0"
  }
}
