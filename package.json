{
  "name": "packlight",
  "version": "0.0.0",
  "private": true,
  "description": "See what your coding agent carries, keep what you use, archive the rest.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "packlight": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scan": "node --import tsx src/cli.ts scan"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
